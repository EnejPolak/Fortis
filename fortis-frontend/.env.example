# Kopiraj v .env.local in izpolni z dejanskimi vrednostmi.
# .env.local je v .gitignore – ne commitaj ključev.

# Obvezno za pravilne OG/sitemap/JSON-LD URL-je v produkciji:
NEXT_PUBLIC_SITE_URL=https://www.fortisniche.com

# Opcijsko – Organization sameAs (Instagram, Facebook …):
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/fortisnicheatelier
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/...

# Stripe (Dashboard → Developers → API keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook (Dashboard → Developers → Webhooks → Signing secret)
# Format: whsec_...  (NI pk_test_ ali sk_test_!)
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (Project Settings → API)
# URL brez /rest/v1/ na koncu
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Vercel Cron keep-alive (Supabase free tier) — naključen string, isti v Vercel
CRON_SECRET=

# Email obvestilo ob novem naročilu (Resend → resend.com)
ORDER_NOTIFY_EMAIL=
RESEND_API_KEY=re_...
ORDER_NOTIFY_FROM=Fortis <orders@fortisniche.com>
