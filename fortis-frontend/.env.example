# —— Public (safe for client bundle) ——
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key (new) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Site URL used in Stripe redirects (optional; falls back to VERCEL_URL / localhost)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Flat delivery price in EUR cents. Leave unset to keep delivery disabled.
NEXT_PUBLIC_DELIVERY_CENTS=

# —— Server only (never expose to client) ——
SUPABASE_SERVICE_ROLE_KEY=
# Database password (Dashboard → Settings → Database) — for npm run db:migrate only
SUPABASE_DB_PASSWORD=
# Or full URI (preferred if pooler region differs):
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
STRIPE_SECRET_KEY=
# From `stripe listen` (local) OR Dashboard webhook endpoint (deploy) — never commit
STRIPE_WEBHOOK_SECRET=
# ONLY these emails may access /admin (comma-separated). profiles.is_admin cannot bypass this.
ADMIN_EMAILS=
# Resend transactional email (https://resend.com) — verified domain required for production From
RESEND_API_KEY=
EMAIL_FROM=FORTIS Niche Atelier <orders@your-domain.com>
# Alias also accepted:
# ORDER_NOTIFY_FROM=FORTIS Niche Atelier <orders@your-domain.com>
# While testing, force all mail to this address (required before any live Resend send in scripts)
EMAIL_TEST_RECIPIENT=
# Cron reconciliation (/api/cron/commerce)
CRON_SECRET=
